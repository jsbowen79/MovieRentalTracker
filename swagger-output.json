    "/movies/": {
      "post": {
        "tags": ["Available Movies"],
        "description": "Create a new available movie",
        "parameters": [
          {
            "name": "movieId",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "availableCopies": { "type": "number" }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Movie created successfully"
          },

          "400": {
            "description": "UserDataError: There is no movie with that Id."
          },
          "500": {
            "description": "MongoDBConnectionError: There was a problem with the database."
          }
        }
      },

      "get": {
        "tags": ["Available Movies"],
        "description": "Get all available movies",
        "responses": {
          "200": {
            "description": "Success - returns all movies"
          },
          "500": {
            "description": "MongoDBConnectionError: There was a problem with the Database."
          }
        }
      }
    },

