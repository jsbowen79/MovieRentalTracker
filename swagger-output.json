    "/movies/": {
      "post": {
        "tags": ["Available Movies"],
        "description": "Create a new available movie",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "availableCopies": { "type": "number" },
                "movieId": { "type": "string" }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Movie created successfully"
          },

          "400": {
            "description": "UserDataError: There is no movie with that Id."
          },
          "500": {
            "description": "MongoDBConnectionError: There was a problem with the database."
          }
        }
      },

      "get": {
        "tags": ["Available Movies"],
        "description": "Get all available movies",
        "responses": {
          "200": {
            "description": "Success - returns all movies"
          },
          "500": {
            "description": "MongoDBConnectionError: There was a problem with the Database."
          }
        }
      }
    },

    "/movies/{genreId}": {
      "get": {
        "tags": ["Available Movies"],
        "description": "Get movies filtered by genre",
        "parameters": [
          {
            "name": "genreId",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Success - returns filtered movies"
          },
          "404": {
            "description": "NotFoundError: No movies were found in that genre."
          },
          "500": {
            "description": "MongoDBConnectionError: There was a problem with the Database."
          }
        }
      }
    },

    "/movies/{movieId}": {
      "put": {
        "tags": ["Available Movies"],
        "description": "Update a movie by ID",
        "parameters": [
          {
            "name": "movieId",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "availableCopies": { "type": "number" }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Movie updated successfully"
          },
          "404": {
            "description": "NotFoundError: There are no movies with that Id."
          },
          "500": {
            "description": "MongoDBConnectionError: There was a problem with the Database."
          }
        }
      },

      "delete": {
        "tags": ["Available Movies"],
        "description": "Delete a movie by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Movie deleted successfully"
          },
          "404": {
            "description": "NotFoundError: The movie does not exist."
          },
          "500": {
            "description": "MongoDBConnectionError: There was a problem with the Database."
          }
        }
      }
    },
    "/rented/{userId}": {
      "post": {
        "tags": ["Rented Movies"],
        "description": "Add a movie rental to a user's record",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "movieId": {
                  "type": "string"
                }
              },
              "required": ["movieId"]
            }
          }
        ],
        "responses": {
          "400": {
            "description": "UserDataError",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Please provide the movieId and the userId, The requested movie is not available"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "NotFoundError--No user matching that userId exists.  Please try again.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "No user matching that userId Exists. The requested movie is not available. The requested movie does not exist in the database."
                    }
                  }
                }
              }
            }
          },

          "500": {
            "description": "MongoDBConnectionError--There was a problem with the database. Please try again."
          }
        }
      },

      "get": {
        "tags": ["Rented Movies"],
        "description": "List all of the movies that an individual user has rented",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "400": {
            "description": "UserDataError--You must provide a userId."
          },
          "404": {
            "description": "NotFoundError--This user has rented no movies."
          },
          "500": {
            "description": "MongoDBConnectionError--There was a problem connecting with the Database."
          }
        }
      }
    },
    "/rented/": {
      "get": {
        "tags": ["Rented Movies"],
        "description": "Get a list of all movies in the Rented Movies database.",
        "responses": {
          "404": {
            "description": "NotFoundError--There are no entries in the database. "
          },
          "500": {
            "description": "MongoDBConnectionError--There was a problem with the database.  Please try again."
          }
        }
      }
    },
    "/rented/out/{userId}": {
      "get": {
        "tags": ["Rented Movies"],
        "description": "Get a list of movies currently listed as in the user's possession",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "400": {
            "description": "UserDataError--You must provide a userId"
          },
          "500": {
            "description": "MongoDBConnectionError--There was a problem with the database. Please try again."
          }
        }
      }
    },
    "/rented/{transId}": {
      "delete": {
        "tags": ["Rented Movies"],
        "description": "Delete a transaction from the database.  Admin authorization required",
        "parameters": [
          {
            "name": "transId",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "400": {
            "description": "UserDataError--You must include a transaction Id to delete a transaction"
          },
          "401": {
            "description": "UnauthorizedError--You must be logged in as an administrator to delete a transaction."
          },
          "500": {
            "description": "MongoDBConnectionError--There was a problem with the Database.  Please try again."
          },
          "404": {
            "description": "No transaction with that transaction Id exists."
          }
        }
      },
      "put": {
        "tags": ["Rented Movies"],
        "description": "Update a rental transaction in the database",
        "parameters": [
          {
            "name": "transId",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": false,
            "schema": {
              "type": "object",
              "properties": {
                "movieId": {
                  "type": "string"
                },
                "userId": {
                  "type": "string"
                },
                "out": {
                  "type": "boolean"
                },
                "dateReturned": {
                  "type": "string"
                }
              }
            }
          }
        ],
        "responses": {
          "400": {
            "description": "UserDataError",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "There is no transaction with that Id. A transaction Id is required to update a transaction."
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "MongoDBConnectionError--There was a problem with the database. Update failed."
          }
        }
      }
    },

